config LIBUKVMRESTORE
	bool "ukvmrestore: Firecracker snapshot generation and entropy"
	depends on (ARCH_ARM_64 || ARCH_X86_64) && KVM_VMM_FIRECRACKER
	select LIBUKOFW if ARCH_ARM_64
	select LIBUKBUS_PLATFORM if ARCH_ARM_64
	select LIBVIRTIO_BUS if ARCH_ARM_64
	select LIBVIRTIO_RING if ARCH_ARM_64
	select LIBUKSGLIST if ARCH_ARM_64
	select LIBUKINTCTLR
	select LIBUKLIBPARAM
	select LIBUKFILE_POLLED
	select LIBPOSIX_VFS
	select LIBUKFS_DEVFS
	select LIBUKRANDOM
	select LIBUKLOCK
	select LIBUKPM
	select LIBUKSCHED
	select LIBUKVSOCKDEV
	select LIBUKVSOCKDEV_DISPATCHERTHREADS
