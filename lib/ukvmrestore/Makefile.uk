$(eval $(call addlib_s,libukvmrestore,$(CONFIG_LIBUKVMRESTORE)))
$(eval $(call addlib_paramprefix,libukvmrestore,vmrestore))

LIBUKVMRESTORE_SRCS-y += $(LIBUKVMRESTORE_BASE)/restore.c
LIBUKVMRESTORE_CFLAGS-y += $(ISR_ARCHFLAGS) $(ISR_ARCHFLAGS-y)

ifeq ($(CONFIG_ARCH_ARM_64),y)
LIBUKVMRESTORE_SRCS-y += $(LIBUKVMRESTORE_BASE)/entropy.c
LIBUKVMRESTORE_CINCLUDES-y += -I$(UK_PLAT_COMMON_BASE)/include
LIBUKVMRESTORE_CINCLUDES-y += -I$(LIBVIRTIO_BUS_BASE)/include
LIBUKVMRESTORE_CINCLUDES-y += -I$(LIBVIRTIO_RING_BASE)/include
LIBUKVMRESTORE_CINCLUDES-y += -I$(UK_DRIV_LIBVIRTIO_BASE)/include
endif
