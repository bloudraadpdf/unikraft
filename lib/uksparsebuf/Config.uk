menuconfig LIBUKSPARSEBUF
	bool "uksparsebuf: Sparse page buffers"
	select LIBUKALLOC

if LIBUKSPARSEBUF

config LIBUKSPARSEBUF_TEST
	bool "Test sparse buffer metadata release"
	default n
	select LIBUKTEST

choice LIBUKSPARSEBUF_IMPL
	prompt "Implementation"
	default LIBUKSPARSEBUF_IMPL_RBTREE

config LIBUKSPARSEBUF_IMPL_RBTREE
	bool "Rank-balanced tree"

endchoice

endif
