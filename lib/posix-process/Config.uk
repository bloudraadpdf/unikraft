menuconfig LIBPOSIX_PROCESS
	bool "posix-process: Process-related functions"
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKLCPU
	select LIBUKNOFAULT

if LIBPOSIX_PROCESS

menuconfig LIBPOSIX_PROCESS_MULTITHREADING
	bool "Multithreading support"
	select LIBUKBITOPS
	select LIBUKLOCK
	select LIBUKLOCK_MUTEX
	select LIBUKNOFAULT

if LIBPOSIX_PROCESS_MULTITHREADING
config LIBPOSIX_PROCESS_MAX_PID
	int "Largest TID"
	range 1 32767
	default 31

menuconfig LIBPOSIX_PROCESS_BRK
	bool "brk() system call and sbrk() libc function"
	select LIBUKALLOC

if LIBPOSIX_PROCESS_BRK

config LIBPOSIX_PROCESS_BRK_PAGE_ORDER
	int "Initial heap size for brk (page order)"
	default 9
	help
		The initial heap size is 2^order * page size. With ukvmem,
		this reserves address space while an executable loads. Unused
		space is released before execution and the heap grows dynamically.
		Without ukvmem, this sets the fixed heap allocation size.

config LIBPOSIX_PROCESS_BRK_INC_MEMZERO
	bool "Zero memory upon brk increments"
	default y
	help
		Zero newly allocated heap bytes. With ukvmem, newly mapped
		pages are always zeroed on demand.

endif

config LIBPOSIX_PROCESS_CLONE_PREFER_CHILD
	bool "Prefer scheduling of child"
	help
		If enabled, clone will context switch away from the clone
		caller. This is necessary for some applications that assume that
		the new thread does progress while the clone caller is not
		context switching.

config LIBPOSIX_PROCESS_EXECVE
	bool "execve() system call"
	depends on HAVE_VFS
	select LIBUKBINFMT

config LIBPOSIX_PROCESS_STACK_SIZE
	int "Default application stack limit in bytes"
	depends on LIBPOSIX_PROCESS_EXECVE
	default 8388608
	range 4096 1073741824

endif

config LIBPOSIX_PROCESS_MULTIPROCESS
	bool "Multiprocess support"
	depends on HAVE_VFS
	select LIBPOSIX_PROCESS_MULTITHREADING
	select LIBPOSIX_PROCESS_EXECVE
	select LIBUKLOCK
	select LIBUKLOCK_SEMAPHORE

config LIBPOSIX_PROCESS_SIGNAL
	bool "POSIX signals (EXPERIMENTAL)"
	select LIBPOSIX_PROCESS_MULTITHREADING
	select LIBPOSIX_PROCESS_EXECVE
	select LIBUKLOCK
	select LIBUKLOCK_SEMAPHORE

config LIBPOSIX_PROCESS_ARCH_PRCTL
	bool "arch_prctl() system call"
	depends on ARCH_X86_64

config LIBPOSIX_PROCESS_PREEMPT
	bool "Preempt binary application threads"
	depends on LIBPOSIX_PROCESS_EXECVE && PLAT_KVM
	depends on ARCH_ARM_64 || LIBUKINTCTLR_APIC
	help
		Use a local one-shot timer to schedule application threads that
		do not enter the kernel. Kernel execution remains cooperative.

config LIBPOSIX_PROCESS_SIGNALFD
	bool "signalfd4() and signalfd() syscalls"
	depends on LIBPOSIX_PROCESS_SIGNAL
	select LIBUKFILE_POLLED

config LIBPOSIX_PROCESS_SYSV_IPC
	bool
	select LIBUKNOFAULT
	select LIBPOSIX_USER
	select LIBPOSIX_TIME

config LIBPOSIX_PROCESS_SYSV_SHM
	bool "System V shared memory"
	depends on ARCH_X86_64 || ARCH_ARM_64
	depends on LIBPOSIX_PROCESS_MULTITHREADING && LIBPOSIX_FDIO_VMA_COPY
	select LIBPOSIX_PROCESS_SYSV_IPC
	select LIBUKFS_RAMFS
	select LIBPOSIX_FD_HEAPOFD

config LIBPOSIX_PROCESS_SYSV_SEM
	bool "System V semaphores"
	depends on ARCH_X86_64 || ARCH_ARM_64
	depends on LIBPOSIX_PROCESS_SIGNAL
	select LIBPOSIX_PROCESS_SYSV_IPC

config LIBPOSIX_PROCESS_SYSV_MSG
	bool "System V message queues"
	depends on ARCH_X86_64 || ARCH_ARM_64
	depends on LIBPOSIX_PROCESS_SIGNAL
	select LIBPOSIX_PROCESS_SYSV_IPC

config LIBPOSIX_PROCESS_DEBUG
	bool "Enable debug messages"

endif
