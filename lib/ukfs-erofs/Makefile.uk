$(eval $(call addlib_s,libukfs_erofs,$(CONFIG_LIBUKFS_EROFS)))

EROFS_ORIGIN := $(CONFIG_UK_BASE)/vendor/erofs-utils
LZ4_ORIGIN := $(CONFIG_UK_BASE)/vendor/lz4
LIBUKFS_EROFS_CINCLUDES-y += -I$(LIBUKFS_EROFS_BASE)/include
LIBUKFS_EROFS_CINCLUDES-y += -I$(EROFS_ORIGIN)/include -I$(EROFS_ORIGIN)/lib -I$(LZ4_ORIGIN)/lib
LIBUKFS_EROFS_CFLAGS-y += -DHAVE_CONFIG_H -DNDEBUG -DEROFS_READONLY
LIBUKFS_EROFS_SRCS-y += $(LIBUKFS_EROFS_BASE)/erofs.c
LIBUKFS_EROFS_SRCS-y += $(LIBUKFS_EROFS_BASE)/reader-io.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/namei.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/data.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/zmap.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/decompress.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/super.c
LIBUKFS_EROFS_SRCS-y += $(EROFS_ORIGIN)/lib/dir.c
LIBUKFS_EROFS_SRCS-y += $(LZ4_ORIGIN)/lib/lz4.c
